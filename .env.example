# ---------- Flask ----------
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too-another-long-random-string

# Access token lifetime (minutes) and refresh token lifetime (days)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---------- Database ----------
# PostgreSQL connection string:
#   postgresql://<user>:<password>@<host>:<port>/<database>
# Put the password you chose while installing PostgreSQL here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_cms
# Separate database used only by the automated tests (pytest)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_cms_test

# ---------- First admin user (created by seed.py) ----------
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Portfolio Admin

# ---------- CORS (comma separated frontend URLs) ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Uploads ----------
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=5
# Public base URL of this API (used to build absolute image URLs)
PUBLIC_BASE_URL=http://localhost:5000

# ---------- Email for contact form (optional) ----------
# If SMTP_HOST is empty, emails are printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=
# Where contact-form notifications are sent
MAIL_TO=
